<Window x:Class="Barline.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Barline.Ui"
        x:ClassModifier="internal"
        Title="Barline"
        Width="560" Height="805"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!--
        Grayscale text antialiasing, matching the overlay and Windows 11's own XAML
        shell. ClearType would be available here (unlike on the layered overlay) but
        would make this window the one piece of the app whose text renders differently
        from the rest of the shell.
    -->

    <Window.Resources>
        <!-- Theme brushes, swapped wholesale by ApplyTheme on a system theme change.
             Values here are the dark-mode defaults so the designer and first load
             have something sane before ApplyTheme runs. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#1A000000" />
        <SolidColorBrush x:Key="ControlAltFillBrush" Color="#1A000000" />
        <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#8BFFFFFF" />
        <SolidColorBrush x:Key="AccentFillBrush" Color="#FF0078D4" />
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />

        <!-- Section header. Windows 11 Settings uses body-strong for these: same
             size as body text, heavier weight — not a larger font. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Marks a control the free build cannot use. Collapsed by default, so a
             licensed window never has to undo anything. -->
        <Style x:Key="LockGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="&#xE72E;" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- The settings card: the single most recognizable piece of Windows 11
             Settings. 4px radius, faint fill, hairline border. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- WPF has no ToggleSwitch, so a CheckBox is retemplated as one: 40x20
             track, 12px knob, 4px inset. The knob slides rather than jumping —
             an instant snap is the tell that a switch is hand-made. -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="{DynamicResource ControlAltFillBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True" />
                            <Ellipse x:Name="Knob"
                                     Width="12" Height="12"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"
                                     Fill="{DynamicResource ControlStrongStrokeBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="Transparent" />
                                <Setter TargetName="Knob" Property="Fill"
                                        Value="{DynamicResource TextOnAccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="KnobShift"
                                                Storyboard.TargetProperty="X"
                                                To="20" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="KnobShift"
                                                Storyboard.TargetProperty="X"
                                                To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color-mode option. Checked state fills the ring with the accent and puts
             a knockout dot in it, as WinUI's RadioButton does. -->
        <Style x:Key="ColorOption" TargetType="RadioButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Hover"
                                CornerRadius="4"
                                Background="Transparent"
                                Padding="8,9"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="20" Height="20"
                                      VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource ControlStrongStrokeBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse x:Name="Dot"
                                             Width="8" Height="8"
                                             Fill="{DynamicResource TextOnAccentBrush}"
                                             Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill"
                                        Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Ring" Property="Stroke"
                                        Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Dot" Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <!-- A locked option that still looks live reads as a bug
                                 rather than as a lock, and the padlock alone is too
                                 quiet to carry it. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of the bar-count selector. A segmented control rather than a
             third stack of radio rows: the counts are points on a scale, which a row
             of segments shows and a vertical list does not, and it keeps the page
             short enough that the default view still needs no scrolling. -->
        <Style x:Key="SegmentOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fill"
                                CornerRadius="3"
                                Background="Transparent"
                                Padding="14,5"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="Lock"
                                           Style="{StaticResource LockGlyph}"
                                           FontSize="10" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ui:SettingCard.Locked" Value="True">
                                <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource AccentFillBrush}" />
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource TextOnAccentBrush}" />
                            </Trigger>
                            <!-- Hover only while unselected, so it cannot wash out the
                                 accent fill on the segment already chosen. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The pill that holds a row of segments. Extracted because there are now
             four of them and they must stay identical. -->
        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlAltFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Windows 11 standard button: a faint filled rounded rect that lifts on
             hover and sinks on press. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Background="{DynamicResource ControlAltFillBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="Lock"
                                           Style="{StaticResource LockGlyph}"
                                           FontSize="10" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ui:SettingCard.Locked" Value="True">
                                <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                            <!-- Import is unavailable with nothing playing, and has to
                                 look it — an enabled button that does nothing reads as
                                 broken. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A color well that opens the palette. Its own fill is set from code, so the
             template only supplies the frame and the hover state. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Chequerboard behind, so a partly transparent color
                                 reads as transparent rather than as a darker one. -->
                            <Border CornerRadius="3" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,8"
                                                  ViewportUnits="Absolute" Stretch="None">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#20808080">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,4,4" />
                                                        <RectangleGeometry Rect="4,4,4,4" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Fill"
                                    CornerRadius="3"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 combo box. WPF's default is still the Windows 7 look, so the
             whole thing is retemplated: a rounded field with a chevron, and a rounded
             popup list. -->
        <Style x:Key="CardComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Margin="4,1"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource AccentFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardCombo" TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Foreground is set here, not left to inherit. A
                                 ToggleButton picks up the stock theme style, which
                                 sets its own near-black Foreground and so breaks the
                                 chain from the ComboBox — leaving the box's label
                                 black on a dark card while the drop-down list, which
                                 inherits from the ComboBox directly, stayed correct. -->
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Fill"
                                                CornerRadius="4"
                                                Background="{DynamicResource ControlAltFillBrush}"
                                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                                BorderThickness="1"
                                                Padding="10,5"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  VerticalAlignment="Center" />
                                                <!-- Segoe Fluent Icons ChevronDown, as
                                                     the rest of the widget uses. -->
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="&#xE70D;" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fill" Property="Background"
                                                        Value="{DynamicResource SubtleHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    VerticalAlignment="Center" />
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        CornerRadius="6"
                                        Background="{DynamicResource WindowBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <!-- CanContentScroll is what lets the items panel
                                         virtualize; without it every item is realized
                                         up front. -->
                                    <ScrollViewer Style="{DynamicResource OverlayScrollViewer}"
                                                  CanContentScroll="True"
                                                  Margin="0,4">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 slider: a thin track with the filled portion in the accent and
             a ringed knob that grows on hover. -->
        <Style x:Key="CardSlider" TargetType="Slider">
            <Setter Property="Width" Value="170" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlStrongStrokeBrush}"
                                    Opacity="0.45" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <!-- Dynamic, not static: this style is declared
                                         further down the dictionary, and a static
                                         reference only sees what precedes it. -->
                                    <RepeatButton Style="{DynamicResource ScrollPageButton}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <!-- Dynamic, not static: this style is declared
                                         further down the dictionary, and a static
                                         reference only sees what precedes it. -->
                                    <RepeatButton Style="{DynamicResource ScrollPageButton}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Knob">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20" Background="Transparent">
                                                    <Ellipse Fill="{DynamicResource AccentFillBrush}" />
                                                    <Ellipse x:Name="Core"
                                                             Width="9" Height="9"
                                                             Fill="{DynamicResource TextOnAccentBrush}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Core" Property="Width" Value="11" />
                                                        <Setter TargetName="Core" Property="Height" Value="11" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Swatch button for the custom palette. Content is the color itself, so
             the template is just a rounded fill with a selection ring. -->
        <!-- Sized so all twelve hues fit one row inside the card at the default window
             width. At 32px plus an 8px gap they came to exactly the available width and
             wrapped a single swatch onto a second row. -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Selection"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    BorderBrush="Transparent" />
                            <Border CornerRadius="3"
                                    Margin="4"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush"
                                        Value="{DynamicResource ControlStrongStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hex entry. WinUI-ish: rounded, faint fill, hairline border. -->
        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Width" Value="110" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4"
                                Background="{DynamicResource ControlAltFillBrush}"
                                BorderBrush="{DynamicResource ControlStrongStrokeBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hairline divider between rows inside one card. -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>

        <!-- The header of an expandable card. A whole-width button rather than a
             chevron you have to hit: Windows 11 expands one of these from anywhere on
             the row, and a 12px target would be the tell that this is hand-made. -->
        <Style x:Key="ExpanderHeaderButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Background="Transparent"
                                Padding="16,14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The expandable settings card, which is what keeps a page of thirty controls
            readable: a header carrying the setting's name and what it currently says,
            with the detail folded away until asked for. Windows 11 Settings never shows
            more than a handful of rows at once, and this is how.

            The summary on the header is the part that makes it work. Folding controls
            away behind a row of chevrons with nothing but nouns beside them hides
            settings rather than tidying them.
        -->
        <Style x:Key="ExpanderCard" TargetType="Expander">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="4"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <ToggleButton Style="{StaticResource ExpanderHeaderButton}"
                                              IsChecked="{Binding IsExpanded,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          Content="{Binding Header,
                                                              RelativeSource={RelativeSource TemplatedParent}}" />

                                        <TextBlock Grid.Column="1"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding (ui:SettingCard.Summary),
                                                       RelativeSource={RelativeSource TemplatedParent}}" />

                                        <Path x:Name="Chevron"
                                              Grid.Column="2"
                                              Margin="14,0,2,0"
                                              Width="14" Height="10"
                                              Stretch="None"
                                              Data="M 1,2 L 6,7 L 11,2"
                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                              StrokeThickness="1.3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </ToggleButton>

                                <Border x:Name="Body"
                                        Visibility="Collapsed"
                                        Padding="16,0,16,14">
                                    <StackPanel>
                                        <Border Style="{StaticResource RowDivider}" Margin="0,0,0,12" />
                                        <ContentPresenter />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Repeat buttons for the scrollbar track. Windows 11 has no arrow buttons on
             its scrollbars, but the Track still needs page-up/page-down regions, so
             they are present and invisible rather than removed. -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin Windows 11-style scrollbar: no arrows, no track, a 3px rounded
             thumb that thickens on hover. WPF's stock scrollbar is a wide bordered
             control with arrow buttons at both ends, which looks like a Windows 7 app. -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <!-- Dynamic, not static: this style is declared
                                         further down the dictionary, and a static
                                         reference only sees what precedes it. -->
                                    <RepeatButton Style="{DynamicResource ScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <!-- Dynamic, not static: this style is declared
                                         further down the dictionary, and a static
                                         reference only sees what precedes it. -->
                                    <RepeatButton Style="{DynamicResource ScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Fully opaque at rest. The brush is
                                                     already only ~55% white, and at 70%
                                                     of that the thumb was invisible —
                                                     which hides the fact that there is
                                                     more of the page below. -->
                                                <Border x:Name="ThumbFill"
                                                        Width="4"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource ControlStrongStrokeBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The scrollbar overlays the content instead of taking a column beside it.
             A reserved gutter is visible even when nothing scrolls, and it shifts the
             whole page sideways the moment the custom-color card expands. -->
        <Style x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ThinScrollBar}"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       Margin="0,4"
                                       Value="{Binding VerticalOffset, Mode=OneWay,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer Style="{StaticResource OverlayScrollViewer}">
        <StackPanel Margin="24,16,24,24">

            <!-- === Preview === -->

            <TextBlock Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,8"
                       Text="Visualizer" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Preview" />
                    <TextBlock x:Name="PreviewCaption"
                               Style="{StaticResource CardDescription}"
                               Text="Shown against the taskbar's approximate shade." />

                    <!-- Background is set from code to the theme's backdrop estimate —
                         the same value the contrast correction measures against, so
                         this preview is honest about what the bars have to survive. -->
                    <Border x:Name="PreviewStrip"
                            CornerRadius="4"
                            Height="48"
                            Margin="0,12,0,0"
                            SnapsToDevicePixels="True">
                        <ui:Visualizer x:Name="PreviewBars"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- === Show the bars === -->

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardLabel}" Text="Show visualizer" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="With it off, the title and artist get its space." />
                    </StackPanel>
                    <CheckBox x:Name="VisualizerToggle" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}" />
                </Grid>
            </Border>

            <!-- === Bar count === -->

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardLabel}" Text="Bars" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="They divide a fixed width, so more bars are thinner ones." />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="16,0,0,0"
                            CornerRadius="4"
                            Padding="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlAltFillBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="SimpleOption"
                                         GroupName="BarCount"
                                         Style="{StaticResource SegmentOption}"
                                         Content="Simple" />
                            <RadioButton x:Name="BalancedOption"
                                         GroupName="BarCount"
                                         Style="{StaticResource SegmentOption}"
                                         Content="Balanced" />
                            <RadioButton x:Name="DetailedOption"
                                         GroupName="BarCount"
                                         Style="{StaticResource SegmentOption}"
                                         Content="Detailed" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- === Bar color === -->

            <Expander x:Name="BarColorExpander" Style="{StaticResource ExpanderCard}">
                <Expander.Header>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Bar color" />
                </Expander.Header>

                <StackPanel>
                    <RadioButton x:Name="DefaultOption" Style="{StaticResource ColorOption}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DefaultLabel" Grid.Column="0"
                                       Style="{StaticResource CardLabel}"
                                       Text="Default" VerticalAlignment="Center" />
                            <Border x:Name="DefaultSwatch" Grid.Column="1"
                                    Width="36" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="DefaultHex" Grid.Column="2"
                                       Width="72" Margin="10,0,0,0"
                                       FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="AccentOption" Style="{StaticResource ColorOption}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AccentLabel" Grid.Column="0"
                                       Style="{StaticResource CardLabel}"
                                       Text="Windows accent" VerticalAlignment="Center" />
                            <Border x:Name="AccentSwatch" Grid.Column="1"
                                    Width="36" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="AccentHex" Grid.Column="2"
                                       Width="72" Margin="10,0,0,0"
                                       FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="AlbumArtOption" Style="{StaticResource ColorOption}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AlbumArtLabel" Grid.Column="0"
                                       Style="{StaticResource CardLabel}"
                                       Text="From album art" VerticalAlignment="Center" />
                            <TextBlock x:Name="AlbumArtLock" Grid.Column="1"
                                       Style="{StaticResource LockGlyph}" />
                            <Border x:Name="AlbumArtSwatch" Grid.Column="2"
                                    Width="36" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="AlbumArtHex" Grid.Column="3"
                                       Width="72" Margin="10,0,0,0"
                                       FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="CustomOption" Style="{StaticResource ColorOption}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CustomLabel" Grid.Column="0"
                                       Style="{StaticResource CardLabel}"
                                       Text="Custom" VerticalAlignment="Center" />
                            <Border x:Name="CustomSwatch" Grid.Column="1"
                                    Width="36" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="CustomHex" Grid.Column="2"
                                       Width="72" Margin="10,0,0,0"
                                       FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <TextBlock Style="{StaticResource CardDescription}"
                               Margin="8,10,0,0"
                               Text="Each hex is what will actually be drawn — colors are adjusted to stay visible against the taskbar." />

                    <!-- === Custom color === -->

                    <StackPanel x:Name="CustomCard" Margin="0,4,0,0" Visibility="Collapsed">
                        <Border Style="{StaticResource RowDivider}" />

                        <TextBlock Style="{StaticResource CardLabel}" Text="Choose a color" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Only the hue matters — lightness is set for you." />

                        <WrapPanel x:Name="SwatchPanel" Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox x:Name="HexInput" Style="{StaticResource HexBox}" />
                            <TextBlock x:Name="HexError"
                                       Style="{StaticResource CardDescription}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- === Lyrics === -->

            <TextBlock Style="{StaticResource SectionHeader}" Text="Lyrics" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardLabel}" Text="Show lyrics" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Looked up from lrclib.net, using the track name and artist." />
                    </StackPanel>
                    <CheckBox x:Name="LyricsToggle" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}" />
                </Grid>
            </Border>

            <!-- Its own card, above everything it covers. A preset saves the whole
                 lyric style — where the lyrics go and how big the panel is, as well as
                 how they look — so keeping the picker inside the card for one of those
                 three understated what loading one would do. -->
            <Border x:Name="LyricsPresetCard"
                    Style="{StaticResource Card}"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Preset" />
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="A saved copy of the whole lyric style: where the lyrics go, the panel's size, and how they look. Kept as a file you can share." />

                    <!-- Below the description rather than beside it, the same way the
                         import card lays out its pair. Three controls in the right-hand
                         column left the description a strip narrow enough to wrap to six
                         lines, which read as a layout fault rather than a description. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ComboBox x:Name="PresetPicker"
                                  Style="{StaticResource CardCombo}"
                                  Width="130" />
                        <Button x:Name="SavePresetButton"
                                Style="{StaticResource CardButton}"
                                Margin="8,0,0,0"
                                Content="Save as…" />
                        <!-- Presets are files meant to be shared, and where they live
                             depends on how the app was installed. Opening the folder is
                             more reliable than naming it. -->
                        <Button x:Name="OpenPresetsButton"
                                Style="{StaticResource CardButton}"
                                Margin="8,0,0,0"
                                Content="Open folder" />
                    </StackPanel>

                    <!-- Collapsed rather than merely empty: a TextBlock with no text
                         still measures a line box, which left a gap under the picker
                         that read as a missing control. -->
                    <TextBlock x:Name="PresetStatus"
                               Style="{StaticResource CardDescription}"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- The one decision the cards below depend on, so it is a row of its own
                 rather than folded away inside one of them. A preset does record it —
                 but what a preset stores and where a control lives are different
                 questions, and answering the second with the first is what put the mode
                 inside "Style" while the settings that react to it sat outside. -->
            <Border x:Name="LyricsPlacementCard"
                    Style="{StaticResource Card}"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardLabel}" Text="Where to show them" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="The widget fits about 25 characters; the panel fits a full line." />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="InlineOption"
                                         GroupName="LyricsDisplay"
                                         Style="{StaticResource SegmentOption}"
                                         Content="In widget" />
                            <RadioButton x:Name="PanelOption"
                                         GroupName="LyricsDisplay"
                                         Style="{StaticResource SegmentOption}"
                                         Content="Panel" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- Everything that only means something for a panel, in one place — the
                 anchor and size, which a preset saves, and the highlight and hover
                 behavior, which it deliberately does not. Grouping by what a setting
                 applies to rather than by what gets saved is the difference between a
                 structure you can read and one you have to be told. -->
            <Expander x:Name="LyricsPanelExpander"
                      Style="{StaticResource ExpanderCard}"
                      Visibility="Collapsed">
                <Expander.Header>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Panel" />
                </Expander.Header>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Position" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Follows the taskbar's own monitor. Saved with the style." />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="AboveWidgetOption"
                                             GroupName="LyricsPosition"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Widget" />
                                <RadioButton x:Name="BottomCenterOption"
                                             GroupName="LyricsPosition"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Bottom" />
                                <RadioButton x:Name="TopCenterOption"
                                             GroupName="LyricsPosition"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Top" />
                                <RadioButton x:Name="CustomPositionOption"
                                             GroupName="LyricsPosition"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Free" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="CustomPositionRow" Visibility="Collapsed">
                        <Border Style="{StaticResource RowDivider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardLabel}" Text="Where exactly" />
                                <TextBlock Style="{StaticResource CardDescription}"
                                           Text="Across and down, as a share of the screen. Arrow keys nudge a tenth of a percent." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Slider x:Name="CustomXSlider" Style="{StaticResource CardSlider}" />
                                <Slider x:Name="CustomYSlider" Style="{StaticResource CardSlider}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CustomXText"
                                           Width="52" Height="28"
                                           TextAlignment="Right" Padding="0,6,0,0"
                                           FontSize="11"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock x:Name="CustomYText"
                                           Width="52" Height="28"
                                           Margin="0,2,0,0"
                                           TextAlignment="Right" Padding="0,6,0,0"
                                           FontSize="11"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Size" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Width and height in pixels. Saved with the style." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Slider x:Name="PanelWidthSlider" Style="{StaticResource CardSlider}" />
                            <Slider x:Name="PanelHeightSlider" Style="{StaticResource CardSlider}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PanelWidthText"
                                       Width="52" Height="28"
                                       TextAlignment="Right"
                                       Padding="0,6,0,0"
                                       FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="PanelHeightText"
                                       Width="52" Height="28"
                                       Margin="0,2,0,0"
                                       TextAlignment="Right"
                                       Padding="0,6,0,0"
                                       FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Highlight" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Light up each word, or the whole line. Not saved with the style." />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="WordByWordOption"
                                             GroupName="LyricsHighlight"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Word" />
                                <RadioButton x:Name="LineAtATimeOption"
                                             GroupName="LyricsHighlight"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Line" />
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="When hovered" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="It never takes clicks, but it can still cover something." />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="HoverNoneOption"
                                             GroupName="LyricsHover"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Stay" />
                                <RadioButton x:Name="HoverFadeOption"
                                             GroupName="LyricsHover"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Fade" />
                                <RadioButton x:Name="HoverHideOption"
                                             GroupName="LyricsHover"
                                             Style="{StaticResource SegmentOption}"
                                             Content="Hide" />
                            </UniformGrid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- === Style === -->

            <Expander x:Name="LyricsStyleExpander"
                      Style="{StaticResource ExpanderCard}"
                      Visibility="Collapsed">
                <Expander.Header>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Style" />
                </Expander.Header>

                <StackPanel>

                    <!-- Type -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Font" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Family, size and weight." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <!-- Each family is drawn in itself, which is how every
                                 other font picker works and the only way to choose one
                                 without trying it. Virtualized, because there are
                                 several hundred and each carries its own typeface. -->
                            <ComboBox x:Name="FontPicker"
                                      Style="{StaticResource CardCombo}"
                                      Width="196"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{Binding}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Slider x:Name="FontSizeSlider"
                                    Style="{StaticResource CardSlider}"
                                    Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Border Style="{StaticResource SegmentGroup}" Margin="0">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="WeightNormalOption"
                                                 GroupName="LyricsWeight"
                                                 Style="{StaticResource SegmentOption}"
                                                 Content="R" />
                                    <RadioButton x:Name="WeightSemiBoldOption"
                                                 GroupName="LyricsWeight"
                                                 Style="{StaticResource SegmentOption}"
                                                 Content="SB" />
                                    <RadioButton x:Name="WeightBoldOption"
                                                 GroupName="LyricsWeight"
                                                 Style="{StaticResource SegmentOption}"
                                                 Content="B" />
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="FontSizeText"
                                       Margin="0,6,0,0"
                                       TextAlignment="Right"
                                       FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <!-- Color -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Text color" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="No contrast correction here, so pick something readable." />
                        </StackPanel>

                        <TextBox x:Name="TextColorInput"
                                 Grid.Column="1"
                                 Style="{StaticResource HexBox}"
                                 Margin="16,0,0,0"
                                 VerticalAlignment="Center" />

                        <Button x:Name="TextColorSwatch"
                                Grid.Column="2"
                                Style="{StaticResource SwatchButton}"
                                Margin="10,0,0,0"
                                ToolTip="Pick a color" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <!-- Unsung opacity and casing -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Unsung words" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="How visible a word is before it is sung." />
                        </StackPanel>

                        <Slider x:Name="UnsungSlider"
                                Grid.Column="1"
                                Style="{StaticResource CardSlider}"
                                Margin="16,0,0,0" />

                        <TextBlock x:Name="UnsungText"
                                   Grid.Column="2"
                                   Width="44"
                                   Margin="10,0,0,0"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Lowercase" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Some looks depend on it." />
                        </StackPanel>

                        <CheckBox x:Name="LowercaseToggle" Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Italic" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="The family's italic face, or a slant if it has none." />
                        </StackPanel>

                        <CheckBox x:Name="ItalicToggle" Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}" />
                    </Grid>

                    <Border Style="{StaticResource RowDivider}" />

                    <!-- Effect -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Effect" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="A blurred copy of the line, drawn behind it." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border Style="{StaticResource SegmentGroup}" Margin="0">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="EffectNoneOption"
                                                 GroupName="LyricsEffect"
                                                 Style="{StaticResource SegmentOption}"
                                                 Content="None" />
                                    <RadioButton x:Name="EffectGlowOption"
                                                 GroupName="LyricsEffect"
                                                 Style="{StaticResource SegmentOption}"
                                                 Content="Glow" />
                                </UniformGrid>
                            </Border>
                            <Slider x:Name="EffectRadiusSlider"
                                    Style="{StaticResource CardSlider}"
                                    Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="EffectRadiusText"
                                   Grid.Column="2"
                                   Width="44"
                                   Margin="10,0,0,0"
                                   TextAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>

                    <!-- Panel-only surface settings -->
                    <StackPanel x:Name="SurfaceSettings">
                        <Border Style="{StaticResource RowDivider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardLabel}" Text="Background" />
                                <TextBlock x:Name="BackgroundHint"
                                           Style="{StaticResource CardDescription}"
                                           Text="Tinted is see-through at the opacity below; None leaves the text over the bare desktop." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Border Style="{StaticResource SegmentGroup}" Margin="0">
                                    <UniformGrid Rows="1">
                                        <RadioButton x:Name="BackgroundTintedOption"
                                                     GroupName="LyricsBackground"
                                                     Style="{StaticResource SegmentOption}"
                                                     Content="Tinted" />
                                        <RadioButton x:Name="BackgroundSolidOption"
                                                     GroupName="LyricsBackground"
                                                     Style="{StaticResource SegmentOption}"
                                                     Content="Solid" />
                                        <RadioButton x:Name="BackgroundNoneOption"
                                                     GroupName="LyricsBackground"
                                                     Style="{StaticResource SegmentOption}"
                                                     Content="None" />
                                    </UniformGrid>
                                </Border>
                                <Slider x:Name="BackgroundOpacitySlider"
                                        Style="{StaticResource CardSlider}"
                                        Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock x:Name="BackgroundOpacityText"
                                       Grid.Column="2"
                                       Width="44"
                                       Margin="10,0,0,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>

                        <StackPanel x:Name="BackgroundColorRow">
                            <Border Style="{StaticResource RowDivider}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardLabel}" Text="Background color" />
                                    <TextBlock Style="{StaticResource CardDescription}"
                                               Text="Tints the panel, or fills it outright." />
                                </StackPanel>

                                <TextBox x:Name="BackgroundColorInput"
                                         Grid.Column="1"
                                         Style="{StaticResource HexBox}"
                                         Margin="16,0,0,0"
                                         VerticalAlignment="Center" />

                                <Button x:Name="BackgroundSwatch"
                                        Grid.Column="2"
                                        Style="{StaticResource SwatchButton}"
                                        Margin="10,0,0,0"
                                        ToolTip="Pick a color" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="CornerRadiusRow">
                            <Border Style="{StaticResource RowDivider}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardLabel}" Text="Corner radius" />
                                    <TextBlock Style="{StaticResource CardDescription}"
                                               Text="How far the panel's corners are rounded." />
                                </StackPanel>

                                <Slider x:Name="CornerRadiusSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource CardSlider}"
                                        Margin="16,0,0,0" />

                                <TextBlock x:Name="CornerRadiusText"
                                           Grid.Column="2"
                                           Width="44"
                                           Margin="10,0,0,0"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Expander>

            <!-- === Your own lyrics === -->

            <Expander x:Name="LyricsFilesExpander"
                      Style="{StaticResource ExpanderCard}"
                      Visibility="Collapsed">
                <Expander.Header>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Lyrics files" />
                </Expander.Header>

                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Use your own file" />
                    <TextBlock x:Name="ImportDescription"
                               Style="{StaticResource CardDescription}"
                               Text="An imported .lrc always wins over the network — the way to fix bad timings, or to add a track the database has never heard of." />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ImportButton"
                                Style="{StaticResource CardButton}"
                                Content="Import for this track…" />
                        <Button x:Name="OpenFolderButton"
                                Style="{StaticResource CardButton}"
                                Margin="8,0,0,0"
                                Content="Open folder" />
                    </StackPanel>

                    <TextBlock x:Name="ImportStatus"
                               Style="{StaticResource CardDescription}"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource TextTertiaryBrush}" />

                    <Border Style="{StaticResource RowDivider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardLabel}" Text="Fetched lyrics" />
                            <TextBlock x:Name="CacheSizeText"
                                       Style="{StaticResource CardDescription}" />
                        </StackPanel>

                        <Button x:Name="ClearCacheButton"
                                Grid.Column="1"
                                Style="{StaticResource CardButton}"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Content="Clear" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- === Startup === -->

            <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardLabel}" Text="Start with Windows" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Run the widget when you sign in." />
                        <!-- Windows can refuse this, and when it does the toggle
                             has to say so rather than sit there looking set. -->
                        <TextBlock x:Name="AutoStartNote"
                                   Style="{StaticResource CardDescription}"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}" />
                </Grid>
            </Border>

            <!-- === About === -->

            <!--
                Not decoration. A Store install has no folder anyone can open: the
                license, the third-party notices and the version all ship inside a
                package under WindowsApps, whose root refuses to be listed, so this
                card is the only route to any of them. GPL-3.0 also asks the binary to
                say where its source can be had, which is what the GitHub button is
                for rather than politeness.
            -->

            <!--
                Its own short section rather than another row in About, which is already
                the longest card on the page.

                Two cards, one of which is always collapsed. Owned, it is a single line
                that says so: buying something and then seeing no trace of it is a poor
                trade, and this is the only place in the app that acknowledges the
                purchase at all.

                The whole section starts hidden, because the portable build has no
                add-on to own and nothing to buy.
            -->

            <StackPanel x:Name="PremiumSection" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SectionHeader}" Text="Barline Plus" />

                <Border x:Name="PremiumOwnedCard"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource AccentFillBrush}"
                                   Text="&#xE8FB;" />
                        <TextBlock Style="{StaticResource CardLabel}"
                                   VerticalAlignment="Center"
                                   Text="Unlocked. You are using every feature." />
                    </StackPanel>
                </Border>

                <Border x:Name="PremiumOfferCard"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="PremiumHeading" Style="{StaticResource CardLabel}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Five and six bars, bar color from the album art, the lyrics panel anywhere on screen, the glow effect, and saving your own presets. A one time purchase, with no subscription." />

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="BuyButton"
                                    Style="{StaticResource CardButton}"
                                    Content="Unlock Barline Plus" />
                            <Button x:Name="RecheckButton"
                                    Style="{StaticResource CardButton}"
                                    Margin="8,0,0,0"
                                    Content="Check again" />
                        </WrapPanel>

                        <TextBlock x:Name="PremiumStatus"
                                   Style="{StaticResource CardDescription}"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="AboutCopyrightText" Style="{StaticResource CardDescription}" />

                    <Border Style="{StaticResource RowDivider}" />

                    <TextBlock Style="{StaticResource CardLabel}" Text="License and source" />
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Barline is free software under GPL-3.0-or-later: you can use it, study how it works, change it and pass it on. The complete source is on GitHub." />

                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="LicenseButton"
                                Style="{StaticResource CardButton}"
                                Margin="0,0,8,0"
                                Content="License" />
                        <Button x:Name="NoticesButton"
                                Style="{StaticResource CardButton}"
                                Margin="0,0,8,0"
                                Content="Third-party notices" />
                        <Button x:Name="SourceButton"
                                Style="{StaticResource CardButton}"
                                Content="Source on GitHub" />
                    </WrapPanel>

                    <Border Style="{StaticResource RowDivider}" />

                    <TextBlock Style="{StaticResource CardLabel}" Text="Privacy" />
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Nothing is collected, and nothing leaves this computer except a lyrics lookup, which only happens while lyrics are switched on." />

                    <Button x:Name="PrivacyButton"
                            Style="{StaticResource CardButton}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Content="Privacy policy" />

                    <Border Style="{StaticResource RowDivider}" />

                    <TextBlock x:Name="SettingsPathText"
                               Style="{StaticResource CardDescription}"
                               Foreground="{DynamicResource TextTertiaryBrush}" />

                    <Button x:Name="OpenDataFolderButton"
                            Style="{StaticResource CardButton}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Content="Open folder" />

                    <TextBlock x:Name="AboutStatus"
                               Style="{StaticResource CardDescription}"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- One palette, retargeted to whichever well opened it. Two identical
                 popups would be two things to keep in step. -->
            <Popup x:Name="ColorPopup"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <!-- Opaque, not the card fill: that token is semi-transparent by
                     design, and a popup that lets the page show through it is
                     unreadable. -->
                <Border CornerRadius="6"
                        Margin="0,4,0,0"
                        Padding="10"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <WrapPanel x:Name="ColorPalette" Width="242" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Margin="2,8,0,0"
                                   Text="Or type any hex value in the box." />
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </ScrollViewer>
</Window>
