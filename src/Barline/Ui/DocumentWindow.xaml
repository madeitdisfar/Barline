<Window x:Class="Barline.Ui.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="720" Height="640"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!--
        Shows a text file the app ships with. There is a window for this rather than a
        call to the shell because neither file can be opened that way: LICENSE has no
        extension at all, and .md has no handler on a stock Windows install, so both
        would raise "How do you want to open this file?" — which reads as a fault.

        It also has to work where the file lives. The Store build installs under
        WindowsApps, whose root refuses to be listed, so the folder cannot be reached
        in Explorer even though the file inside it reads perfectly well by path.
    -->

    <Window.Resources>
        <!-- Dark defaults, replaced wholesale by ApplyTheme. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#1A000000" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Caption"
                   Grid.Row="0"
                   Margin="2,0,2,12"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <Border Grid.Row="1"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="1">
            <!--
                A read-only TextBox rather than a TextBlock: a licence is a thing
                people copy out of, and selection is the whole difference.

                Monospaced and wrapped. Both files are hard-wrapped to about 90
                columns already, so a proportional font would leave every line ragged
                at a width the author had already chosen.
            -->
            <TextBox x:Name="Body"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="14,12"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
    </Grid>
</Window>
