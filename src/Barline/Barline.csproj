<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 10.0.19041.0 platform suffix is what pulls in the WinRT projections
         for Windows.Media.Control (SMTC). Held at 19041 rather than 26100 so the
         binary stays runnable on older Windows 11 installs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for NotifyIcon: WPF has no notification-area
         API of its own, and NotifyIcon is the standard way to avoid hand-rolling
         Shell_NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Barline</AssemblyName>
    <RootNamespace>Barline</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Barline.ico</ApplicationIcon>
    <!-- Identity. An unsigned binary with no publisher accrues no SmartScreen
         reputation, and the Store expects these to be present and stable, so they
         are set here rather than left to the SDK's blank defaults. Version is the
         single source: AssemblyVersion, FileVersion and the LRCLIB user agent all
         derive from it. -->
    <Version>1.2.1</Version>
    <!-- The SDK otherwise appends the commit hash, which then shows up as the
         product version in the file's Properties dialog. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Barline</Product>
    <!-- The person, not the handle: this is the copyright holder, and it is what
         Partner Center shows as the publisher. -->
    <Authors>Minjun Kim</Authors>
    <Company>Minjun Kim</Company>
    <Copyright>Copyright © 2026 Minjun Kim</Copyright>
    <Description>A now-playing widget for the Windows 11 taskbar, with an audio-reactive visualiser and synced lyrics.</Description>
    <!-- No console window, and don't let WPF pick a stale culture -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003 tells WinForms apps to configure DPI via ApplicationHighDpiMode
         instead of the manifest. That does not apply here: this is a WPF app that
         references WinForms solely for NotifyIcon and never calls
         Application.Run, and PerMonitorV2 must be declared in the manifest so it
         takes effect at process start, before any window is positioned. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Release deployment shape, set here rather than passed on the command line: a
       publish that forgets the flags produces a framework-dependent build, which runs
       on the machine that made it and fails on a machine with no .NET installed.
       Confined to Release so ordinary Debug builds stay small and quick. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The WPF native libraries refuse to run from the bundle, so they sit beside
         the executable. Extracting them at startup instead would work, but it writes
         a temp copy on every launch of something meant to start with Windows. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Windows.Forms and System.Drawing as implicit
         global usings, which makes Brush, Color, Application and MouseEventArgs
         ambiguous against their WPF counterparts across the entire project.
         Dropping the globals keeps WPF types unqualified everywhere; TrayIcon,
         the only file that needs WinForms, imports both namespaces explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships beside the executable. NAudio is MIT and is compiled into the binary
         rather than sitting next to it, so its notice has to be carried along
         deliberately or it does not reach whoever receives a copy. -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything in this app is internal, including the colour logic the tests
         exist to pin down. Exposing internals to the test project keeps them that
         way for consumers while letting the tests exercise the real assembly rather
         than a second compilation of the same files. -->
    <InternalsVisibleTo Include="Barline.Tests" />
  </ItemGroup>

</Project>
