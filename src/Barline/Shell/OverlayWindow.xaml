<Window x:Class="Barline.Shell.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Barline.Ui"
        x:ClassModifier="internal"
        Title="Barline"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Width="300" Height="48"
        Left="-10000" Top="-10000">

    <!--
        TextRenderingMode is Grayscale on purpose. A layered window has no opaque
        backdrop to blend subpixels against, so ClearType is unavailable here
        anyway — and Windows 11's own XAML shell text is grayscale-antialiased,
        so this matches the taskbar rather than fighting it.
    -->

    <Window.Resources>
        <!-- Theme brushes. Declared here so DynamicResource resolves at load, then
             swapped wholesale by ApplyTheme when the system theme changes. -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
        <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="ArtPlaceholderBrush" Color="#14FFFFFF" />

        <!-- Soft edge fade for overflowing text. Applied from code only when a line
             actually overflows, so titles that fit are never faded. -->
        <LinearGradientBrush x:Key="EdgeFade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.82" Color="#FF000000" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>

        <!-- Solid transport glyphs as vector geometry rather than icon-font glyphs.
             The Segoe Fluent media glyphs are outline style; these filled shapes
             match the requested look and render crisply at any DPI. Drawn in a
             ~14x14 box, filled via the button Foreground. -->
        <PathGeometry x:Key="PrevGeometry" Figures="M2,1 H4 V13 H2 Z M12,1 L4.5,7 L12,13 Z" />
        <PathGeometry x:Key="NextGeometry" Figures="M2,1 L9.5,7 L2,13 Z M10,1 H12 V13 H10 Z" />
        <PathGeometry x:Key="PlayGeometry" Figures="M2.5,1 L12.5,7 L2.5,13 Z" />
        <PathGeometry x:Key="PauseGeometry" Figures="M2.5,1 H5.5 V13 H2.5 Z M8.5,1 H11.5 V13 H8.5 Z" />

        <!-- Win11 subtle button: no chrome at rest, a faint rounded fill on hover,
             slightly stronger when pressed. The glyph is a filled Path whose Fill
             follows the button Foreground. -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The transport glyph Path: filled with the button's Foreground so theme
             changes and the disabled-opacity trigger both carry through. -->
        <Style x:Key="TransportGlyph" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Window.Resources>

    <!-- HitLayer fills the whole window with a 1/255-alpha black: visually invisible
         (the real taskbar material still shows through) but crucially NON-zero alpha.
         A layered window (AllowsTransparency) is hit-tested PER PIXEL by the OS —
         fully transparent (alpha 0) pixels are click-through, which left the empty
         parts of the widget dead to hover and made the buttons hard to aim at. An
         explicitly rendered element is used rather than Window.Background, which is
         not reliably composited into the layered surface's alpha. -->
    <Grid>
        <Border x:Name="HitLayer" Background="#01000000" />

    <Grid x:Name="Root" Margin="8,0,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Album art. 32x32 with a 4px radius, matching Win11's small-control radius. -->
        <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
            <Border x:Name="ArtPlaceholder"
                    CornerRadius="4"
                    Background="{DynamicResource ArtPlaceholderBrush}" />
            <TextBlock x:Name="ArtFallbackGlyph"
                       FontFamily="Segoe Fluent Icons"
                       Text="&#xE8D6;"
                       FontSize="14"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Border x:Name="ArtLayer" CornerRadius="4" Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="ArtBrush"
                                Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                </Border.Background>
            </Border>
        </Grid>

        <!-- TextArea has an explicit Width (set in code to the available column
             width) and clips. A NoWrap TextBlock ignores width constraints and
             renders at its full content width regardless, so the fade cannot be
             positioned off the TextBlock itself. Instead the OpacityMask goes on
             this fixed-width container — the gradient then maps to the visible
             width — and is toggled on only when a line actually overflows. A line
             that fits never reaches the fade band, so it is never dimmed. -->
        <!-- Spans the right zone as well as its own column. Its width is set in code
             and is the real bound; the span only stops the Grid clipping it back to
             one cell, which it does to any child that overflows its slot. With the
             bars switched off there is nothing drawn in that zone for the text to run
             underneath, and the zone is declared after this so it wins where they do
             overlap. -->
        <Grid x:Name="TextArea"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Margin="10,0,0,0"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Sits over the title and artist rather than beside them: the reserved
                 width is already the tightest part of the layout, so the two states
                 crossfade in place instead of competing for space.

                 Two layers, exactly overlaid, as in the panel. The halo is a blurred
                 copy drawn behind; blurring the live text instead does not glow, it
                 just goes out of focus. -->
            <Grid x:Name="LyricsLayer"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  VerticalAlignment="Center"
                  Opacity="0">
                <TextBlock x:Name="LyricsHalo"
                           FontSize="12"
                           FontWeight="SemiBold"
                           LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"
                           TextWrapping="NoWrap"
                           CacheMode="BitmapCache"
                           Visibility="Collapsed"
                           Text="" />
                <TextBlock x:Name="LyricsText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"
                           TextWrapping="NoWrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="" />
            </Grid>
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       LineHeight="16"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="NoWrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="" />
            <TextBlock x:Name="ArtistText"
                       Grid.Row="1"
                       FontSize="11"
                       FontWeight="Normal"
                       LineHeight="14"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="NoWrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="" />
        </Grid>

        <!-- Fixed-width right zone. The visualiser and the transport controls share
             it and crossfade in place, so hovering never reflows the art or text —
             layout shift on hover is the fastest way to look third-party. -->
        <Grid Grid.Column="2" Width="88">
            <ui:Visualizer x:Name="Bars"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

            <StackPanel x:Name="TransportPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False">
                <Button x:Name="PreviousButton" Style="{StaticResource TransportButton}">
                    <Path Style="{StaticResource TransportGlyph}"
                          Data="{StaticResource PrevGeometry}" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}">
                    <Path x:Name="PlayPauseGlyph"
                          Style="{StaticResource TransportGlyph}"
                          Data="{StaticResource PlayGeometry}" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource TransportButton}">
                    <Path Style="{StaticResource TransportGlyph}"
                          Data="{StaticResource NextGeometry}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</Window>
