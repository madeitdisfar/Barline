<Window x:Class="Barline.Shell.ThankYouWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Barline"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!--
        Shown once, straight after a purchase goes through.

        A status line under a button is the right weight for "no purchase was made" and
        the wrong weight for the one moment somebody has paid for this. It also carries
        the restart, which the status line could only ask for and not perform.
    -->

    <Window.Resources>
        <!-- Dark defaults, replaced wholesale by ApplyTheme. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#1A000000" />
        <SolidColorBrush x:Key="ControlAltFillBrush" Color="#1A000000" />
        <SolidColorBrush x:Key="AccentFillBrush" Color="#FF0078D4" />
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Background="{DynamicResource ControlAltFillBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Background="{DynamicResource AccentFillBrush}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextOnAccentBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,24">

        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="28"
                   Foreground="{DynamicResource AccentFillBrush}"
                   Text="&#xE8FB;" />

        <!-- Both lines say the fresh purchase, and are replaced when the add-on turned
             out to be owned already. -->

        <TextBlock x:Name="Heading"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="Thank you" />

        <TextBlock x:Name="Body"
                   FontSize="14"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Barline Premium is unlocked on this account. Every paid feature is yours, and the paid presets have been added to your folder." />

        <Border Height="1"
                Margin="0,20"
                Background="{DynamicResource CardStrokeBrush}" />

        <TextBlock FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Barline needs to restart before the unlocked settings appear. Nothing is lost either way, and it will still be unlocked next time you start it." />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="RestartStatus"
                       Grid.Column="0"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextTertiaryBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="LaterButton"
                        Style="{StaticResource FlatButton}"
                        Content="Later" />
                <Button x:Name="RestartButton"
                        Style="{StaticResource AccentButton}"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Content="Restart now" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
