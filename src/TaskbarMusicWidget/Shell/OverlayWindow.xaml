<Window x:Class="TaskbarMusicWidget.Shell.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TaskbarMusicWidget.Ui"
        x:ClassModifier="internal"
        Title="Taskbar Music Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Width="300" Height="48"
        Left="-10000" Top="-10000">

    <!--
        TextRenderingMode is Grayscale on purpose. A layered window has no opaque
        backdrop to blend subpixels against, so ClearType is unavailable here
        anyway — and Windows 11's own XAML shell text is grayscale-antialiased,
        so this matches the taskbar rather than fighting it.
    -->

    <Window.Resources>
        <!-- Theme brushes. Declared here so DynamicResource resolves at load, then
             swapped wholesale by ApplyTheme when the system theme changes. -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
        <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="ArtPlaceholderBrush" Color="#14FFFFFF" />

        <!-- Soft edge fade for overflowing text. Applied from code only when a line
             actually overflows, so titles that fit are never faded. -->
        <LinearGradientBrush x:Key="EdgeFade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.82" Color="#FF000000" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>

        <!-- Win11 subtle button: no chrome at rest, a faint rounded fill on hover,
             slightly stronger when pressed. -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- HitLayer fills the whole window with a 1/255-alpha black: visually invisible
         (the real taskbar material still shows through) but crucially NON-zero alpha.
         A layered window (AllowsTransparency) is hit-tested PER PIXEL by the OS —
         fully transparent (alpha 0) pixels are click-through, which left the empty
         parts of the widget dead to hover and made the buttons hard to aim at. An
         explicitly rendered element is used rather than Window.Background, which is
         not reliably composited into the layered surface's alpha. -->
    <Grid>
        <Border x:Name="HitLayer" Background="#01000000" />

    <Grid x:Name="Root" Margin="8,0,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Album art. 32x32 with a 4px radius, matching Win11's small-control radius. -->
        <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
            <Border x:Name="ArtPlaceholder"
                    CornerRadius="4"
                    Background="{DynamicResource ArtPlaceholderBrush}" />
            <TextBlock x:Name="ArtFallbackGlyph"
                       FontFamily="Segoe Fluent Icons"
                       Text="&#xE8D6;"
                       FontSize="14"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Border x:Name="ArtLayer" CornerRadius="4" Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="ArtBrush"
                                Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                </Border.Background>
            </Border>
        </Grid>

        <!-- Two-row Grid, not a StackPanel: in a Grid cell each TextBlock is
             constrained to the column width, so its ActualWidth is the visible
             width and overflowing text is clipped at the cell edge. That lets the
             code apply the edge fade per line ONLY when the text truly overflows,
             positioned exactly at the clip edge. A vertical StackPanel instead
             arranges each line at its full untruncated width, which is what made
             the old fade mis-fire on titles that actually fit. -->
        <Grid Grid.Column="1"
              VerticalAlignment="Center"
              Margin="10,0,0,0"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       LineHeight="16"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="NoWrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="" />
            <TextBlock x:Name="ArtistText"
                       Grid.Row="1"
                       FontSize="11"
                       FontWeight="Normal"
                       LineHeight="14"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="NoWrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="" />
        </Grid>

        <!-- Fixed-width right zone. The visualiser and the transport controls share
             it and crossfade in place, so hovering never reflows the art or text —
             layout shift on hover is the fastest way to look third-party. -->
        <Grid Grid.Column="2" Width="88">
            <ui:Visualizer x:Name="Bars"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

            <StackPanel x:Name="TransportPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False">
                <Button x:Name="PreviousButton"
                        Style="{StaticResource TransportButton}"
                        Content="&#xE892;" />
                <Button x:Name="PlayPauseButton"
                        Style="{StaticResource TransportButton}"
                        Content="&#xE768;" />
                <Button x:Name="NextButton"
                        Style="{StaticResource TransportButton}"
                        Content="&#xE893;" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</Window>
