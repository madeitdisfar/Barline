<Window x:Class="TaskbarMusicWidget.Shell.LyricsPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- AllowsTransparency is what makes this window genuinely see-through: it gives
         WPF a layered window with real per-pixel alpha. The earlier attempt used a DWM
         backdrop instead, which is drawn behind the window and so was hidden by WPF's
         opaque surface — see SystemBackdrop. -->

    <Border x:Name="Root"
            CornerRadius="8"
            Padding="18,12">

        <!-- Two layers, exactly overlaid. The halo is the whole line, blurred and
             static, so it can be bitmap-cached and rasterised once per line — an
             effect on the live text would be re-rendered every frame as the word
             highlight moves. Only used by the styles that want one. -->
        <Grid VerticalAlignment="Center">
            <TextBlock x:Name="HaloLine"
                       LineStackingStrategy="BlockLineHeight"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       CacheMode="BitmapCache"
                       Visibility="Collapsed"
                       Text="" />

            <!-- Large enough to count as large text, which is what makes the 3:1
                 contrast the colour correction guarantees the right bar for it. -->
            <TextBlock x:Name="CurrentLine"
                       LineStackingStrategy="BlockLineHeight"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
